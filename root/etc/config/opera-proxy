config service 'main'
    option enabled '1'
    option country 'EU'
    option bind_address '127.0.0.1:18080'
    option socks_mode '1'
    option verbosity '20'
    option timeout '30s'
    option init_retries '0'
    option init_retry_interval '5s'
    option refresh '4h'
    option refresh_retry '5s'
    option server_selection 'fastest'
    option server_selection_timeout '60s'
    option bootstrap_dns 'tls://9.9.9.9:853'
    option proxy ''
    option api_proxy ''
option api_proxy_file ''
option api_proxy_list_url ''
option api_proxy_builtin '1'
option api_proxy_parallel '15'
option api_proxy_max '60'
option mem_limit_mb '0'
option idle_timeout '0'
    option cafile ''
    option fake_sni ''
    option override_proxy_address ''

    # Browser spoofing — leave empty to use binary built-in defaults.
